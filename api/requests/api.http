@baseUrl = http://localhost:3333
@eventId = 11111111-1111-4111-8111-111111111111

# =============================================================================
# health
# =============================================================================

### health
GET {{baseUrl}}/health

# =============================================================================
# erros gerais
# =============================================================================

### rota inexistente, esperado: 404 ROUTE_NOT_FOUND
GET {{baseUrl}}/rota-inexistente

### request JSON malformado, esperado: 400 INVALID_JSON
POST {{baseUrl}}/health
Content-Type: application/json

{ "campo": }

# =============================================================================
# cors
# =============================================================================

### request cors, origem permitida, esperado: 200 com access-control-allow-origin
GET {{baseUrl}}/health
Origin: http://localhost:5173

### request cors, origem não permitida, esperado: 200 sem access-control-allow-origin
GET {{baseUrl}}/health
Origin: http://localhost:9999

### request cors, origem permitida, esperado: 204 com access-control-allow-origin e access-control-allow-methods
OPTIONS {{baseUrl}}/health
Origin: http://localhost:5173
Access-Control-Request-Method: GET

### request cors, origem não permitida, esperado: 204 sem access-control-allow-origin
OPTIONS {{baseUrl}}/health
Origin: http://localhost:9999
Access-Control-Request-Method: GET

# =============================================================================
# auth: cadastro
# =============================================================================

### cadastro, esperado: 201 com o usuario sem passwordHash
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Vitor Souza",
    "email": "vitor@gereve.dev",
    "password": "senha-forte-123"
}

### cadastro com e-mail em uso, esperado: 409 RESOURCE_ALREADY_EXISTS
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Outro Vitor",
    "email": "vitor@gereve.dev",
    "password": "senha-forte-456"
}

### cadastro com dados invalidos, esperado: 400 VALIDATION_ERROR com details
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Vi",
    "email": "nao-e-email",
    "password": "curta"
}

### cadastro sem corpo, esperado: 400 VALIDATION_ERROR com details
POST {{baseUrl}}/auth/register
Content-Type: application/json

{}

# =============================================================================
# auth: login
# =============================================================================

### login, esperado: 200 com token e usuario sem passwordHash
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "vitor@gereve.dev",
    "password": "senha-forte-123"
}

### login com senha errada, esperado: 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "vitor@gereve.dev",
    "password": "senha-errada-123"
}

### login com e-mail inexistente, esperado: 401 INVALID_CREDENTIALS
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "ninguem@gereve.dev",
    "password": "senha-forte-123"
}

### login com dados invalidos, esperado: 400 VALIDATION_ERROR com details
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "nao-e-email",
    "password": ""
}

# =============================================================================
# auth: usuario autenticado
# =============================================================================

### login guardando o token para as requests seguintes
# @name loginParaMe
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "vitor@gereve.dev",
    "password": "senha-forte-123"
}

### me com token valido, esperado: 200 com o usuario sem passwordHash
GET {{baseUrl}}/auth/me
Authorization: Bearer {{loginParaMe.response.body.$.token}}

### me sem token, esperado: 401 UNAUTHORIZED
GET {{baseUrl}}/auth/me

### me com esquema errado no header, esperado: 401 UNAUTHORIZED
GET {{baseUrl}}/auth/me
Authorization: Token abc.def.ghi

### me com token invalido, esperado: 401 INVALID_TOKEN
GET {{baseUrl}}/auth/me
Authorization: Bearer abc.def.ghi

# =============================================================================
# eventos: criacao
# =============================================================================

### cadastro do cliente de teste, esperado: 201 com o papel CUSTOMER
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Cliente de Teste",
    "email": "cliente@gereve.dev",
    "password": "senha-forte-123"
}

### login como cliente, guardando o token para as requests seguintes
# @name loginCliente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "cliente@gereve.dev",
    "password": "senha-forte-123"
}

# authenticate e authorize rodam antes de validate, entao o corpo nem chega a ser lido
# nas duas requests abaixo

### criacao de evento sem token, esperado: 401 UNAUTHORIZED
POST {{baseUrl}}/events
Content-Type: application/json

{}

### criacao de evento como CUSTOMER, esperado: 403 FORBIDDEN
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{loginCliente.response.body.$.token}}

{}

### cadastro do organizador de teste, esperado: 201 com o papel CUSTOMER
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
    "name": "Organizador de Teste",
    "email": "organizador@gereve.dev",
    "password": "senha-forte-123"
}


#   docker compose exec postgres psql -U gereve -d gereve \
#       -c "UPDATE users SET role = 'ORGANIZER' WHERE email = 'organizador@gereve.dev';"
### login como organizador, guardando o token para as requests seguintes
# @name loginOrganizador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "organizador@gereve.dev",
    "password": "senha-forte-123"
}

### criacao de evento como ORGANIZER, esperado: 201 com status DRAFT
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "title": "Palestra de Node.js",
    "description": "Introdução prática, APIs com Express e Prisma",
    "location": "Lab 4",
    "startsAt": "2026-10-01T18:00:00-03:00",
    "endsAt": "2026-10-01T21:00:00-03:00",
    "capacity": 30
}

### criacao com termino anterior ao inicio, esperado: 400 VALIDATION_ERROR em endsAt
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "title": "Palestra de Node.js",
    "description": "Introdução prática, APIs com Express e Prisma",
    "location": "Lab 4",
    "startsAt": "2026-10-01T21:00:00-03:00",
    "endsAt": "2026-10-01T18:00:00-03:00",
    "capacity": 30
}

### criacao com data fora do padrao e capacidade zero, esperado: 400 VALIDATION_ERROR com dois details
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "title": "Palestra de Node.js",
    "description": "Introdução prática, APIs com Express e Prisma",
    "location": "Lab 4",
    "startsAt": "01/10/2026",
    "endsAt": "2026-10-01T18:00:00-03:00",
    "capacity": 0
}

### criacao sem corpo, esperado: 400 VALIDATION_ERROR com um detail por campo
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{}

# =============================================================================
# eventos: listagem
# =============================================================================

### listagem publica de eventos, esperado: 200 com data e infos, ordenado por startsAt
GET {{baseUrl}}/events

### listagem com paginacao, esperado: 200 com limit 1 e totalPages igual ao total
GET {{baseUrl}}/events?page=1&limit=1

### listagem na segunda pagina, esperado: 200 com page 2
GET {{baseUrl}}/events?page=2&limit=1

### filtro por titulo, sem diferenciar maiusculas, esperado: 200 so com eventos de Node.js
GET {{baseUrl}}/events?title=node

### filtro por status, esperado: 200 com data vazio enquanto nao houver evento publicado
GET {{baseUrl}}/events?status=PUBLISHED

### filtro por intervalo de datas, esperado: 200 so com eventos de outubro de 2026
GET {{baseUrl}}/events?from=2026-10-01T00:00:00-03:00&to=2026-10-31T23:59:59-03:00

### filtro por organizador, esperado: 200 so com eventos daquele organizador
GET {{baseUrl}}/events?organizerId=00000000-0000-0000-0000-000000000000

### ordenacao decrescente por titulo, esperado: 200 ordenado de Z para A
GET {{baseUrl}}/events?sort=title&order=desc

### pagina zero, esperado: 400 VALIDATION_ERROR em page
GET {{baseUrl}}/events?page=0

### limite acima do maximo, esperado: 400 VALIDATION_ERROR em limit
GET {{baseUrl}}/events?limit=101

### status inexistente, esperado: 400 VALIDATION_ERROR em status
GET {{baseUrl}}/events?status=FOO

### organizador fora do formato UUID, esperado: 400 VALIDATION_ERROR em organizerId
GET {{baseUrl}}/events?organizerId=abc

### ordenacao por campo nao permitido, esperado: 400 VALIDATION_ERROR em sort
GET {{baseUrl}}/events?sort=capacity

### detalhe de evento existente, esperado: 200 com o evento criado pelo seed
GET {{baseUrl}}/events/{{eventId}}

### detalhe de evento inexistente, esperado: 404 EVENT_NOT_FOUND
GET {{baseUrl}}/events/00000000-0000-0000-0000-000000000000

### detalhe com id fora do formato UUID, esperado: 400 VALIDATION_ERROR em id
GET {{baseUrl}}/events/abc

# =============================================================================
# eventos: atualizacao e remocao
# =============================================================================

### criacao do evento usado nas requests de edicao, esperado: 201 com status DRAFT
# @name eventoParaEdicao
POST {{baseUrl}}/events
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "title": "Oficina de Prisma",
    "description": "Modelagem de dados, migrations e seed",
    "location": "Lab 2",
    "startsAt": "2026-11-05T19:00:00-03:00",
    "endsAt": "2026-11-05T22:00:00-03:00",
    "capacity": 20
}

### atualizacao parcial pelo dono, esperado: 200 com status PUBLISHED e capacidade 25
PATCH {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "status": "PUBLISHED",
    "capacity": 25
}

### login como a organizadora do seed, que nao e dona do evento
# @name loginOutroOrganizador
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "organizadora@gereve.dev",
    "password": "senha-forte-123"
}

### atualizacao por outro ORGANIZER, esperado: 403 FORBIDDEN
PATCH {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{loginOutroOrganizador.response.body.$.token}}

{
    "title": "Tentativa indevida de edicao"
}

### atualizacao como CUSTOMER, barrada pelo authorize, esperado: 403 FORBIDDEN
PATCH {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{loginCliente.response.body.$.token}}

{
    "title": "Tentativa indevida de edicao"
}

### atualizacao sem token, esperado: 401 UNAUTHORIZED
PATCH {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Content-Type: application/json

{
    "title": "Tentativa indevida de edicao"
}

# so o endsAt e enviado, entao a comparacao usa o startsAt ja gravado no banco

### termino anterior ao inicio ja gravado, esperado: 400 INVALID_EVENT_PERIOD
PATCH {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "endsAt": "2026-11-05T18:00:00-03:00"
}

### status fora do enum, esperado: 400 VALIDATION_ERROR em status
PATCH {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "status": "FINALIZADO"
}

### atualizacao de evento inexistente, esperado: 404 EVENT_NOT_FOUND
PATCH {{baseUrl}}/events/00000000-0000-0000-0000-000000000000
Content-Type: application/json
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

{
    "title": "Evento que nao existe"
}

### remocao por outro ORGANIZER, esperado: 403 FORBIDDEN
DELETE {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Authorization: Bearer {{loginOutroOrganizador.response.body.$.token}}

### login como admin do seed
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@gereve.dev",
    "password": "senha-forte-123"
}

### remocao pelo ADMIN, que nao e o dono, esperado: 204 sem corpo
DELETE {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### remocao do mesmo evento de novo, esperado: 404 EVENT_NOT_FOUND
DELETE {{baseUrl}}/events/{{eventoParaEdicao.response.body.$.id}}
Authorization: Bearer {{loginAdmin.response.body.$.token}}

### remocao com id fora do formato UUID, esperado: 400 VALIDATION_ERROR em id
DELETE {{baseUrl}}/events/abc
Authorization: Bearer {{loginAdmin.response.body.$.token}}

# =============================================================================
# reservas
# =============================================================================

### reserva do evento com capacidade 2 pelo CUSTOMER, esperado: 201 com status CONFIRMED
POST {{baseUrl}}/events/22222222-2222-4222-8222-222222222222/reservations
Authorization: Bearer {{loginCliente.response.body.$.token}}

### reserva repetida no mesmo evento, esperado: 409 RESOURCE_ALREADY_EXISTS
POST {{baseUrl}}/events/22222222-2222-4222-8222-222222222222/reservations
Authorization: Bearer {{loginCliente.response.body.$.token}}

### reserva por ORGANIZER, papel sem permissao, esperado: 403 FORBIDDEN
POST {{baseUrl}}/events/22222222-2222-4222-8222-222222222222/reservations
Authorization: Bearer {{loginOrganizador.response.body.$.token}}

### reserva sem token, esperado: 401 UNAUTHORIZED
POST {{baseUrl}}/events/22222222-2222-4222-8222-222222222222/reservations

### reserva de evento inexistente, esperado: 404 EVENT_NOT_FOUND
POST {{baseUrl}}/events/00000000-0000-0000-0000-000000000000/reservations
Authorization: Bearer {{loginCliente.response.body.$.token}}

### reserva com id fora do formato UUID, esperado: 400 VALIDATION_ERROR em id
POST {{baseUrl}}/events/abc/reservations
Authorization: Bearer {{loginCliente.response.body.$.token}}
